  "cards": [
    {
      "dot": "cyan",
      "title": "两级路由",
      "items": [
        "第一级：BatchProcessor 按 groupKey 选 BatchWorkerGroup",
        "第二级：组内按 routingKey.hashCode() 取模选分区，同一 key 恒入同一分区",
        "分区内 FIFO + 单线程消费 = 严格有序"
      ]
    },
    {
      "dot": "emerald",
      "title": "削峰与限流",
      "items": [
        "submit 只写 Spool 磁盘缓冲即返回，不打满业务线程",
        "分发线程按 rateLimitPerSecond 漏桶限速取数，运行时可热更",
        "Worker 攒满 batchSize 或超 maxWaitMs 触发 flushCallback"
      ]
    },
    {
      "dot": "amber",
      "title": "统计与告警",
      "items": [
        "submit / flush / RT 记入组共享统计，周期快照回调 StatsListener 钩子",
        "flush 失败走 failureHandler；任意环节异常均可触发全局告警（钉钉 / 企微 / 邮件）",
        "flushCallback 写到 DB / API 由业务回调决定，SPI 可扩展"
      ]
    }
  ]
